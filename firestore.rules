rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regla para usuarios administradores
    match /admin_users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.email == 'donaxjimenez00@gmail.com' || get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'Admin');
    }

    // Regla para Equipo
    match /team/{memberId} {
      allow read: if true;
      allow write: if request.auth != null && (get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'Admin' || request.auth.token.email == 'donaxjimenez00@gmail.com');
    }

    // Regla para Programas y Vacantes (Público lee, Admin escribe)
    match /programs/{programId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /vacancies/{vacancyId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regla para Contactos y Postulaciones (Público escribe, Admin lee)
    match /contactos/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /postulaciones/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Transparencia: el público solo ve lo publicado; con sesión se ve y edita todo
    match /transparency_documents/{docId} {
      allow read: if resource.data.published == true || request.auth != null;
      allow write: if request.auth != null;
    }

    // Archivos de Transparencia, guardados por partes
    match /transparency_files/{fileId} {
      allow read: if resource.data.published == true || request.auth != null;
      allow write: if request.auth != null;

      match /chunks/{chunkId} {
        allow read: if request.auth != null
          || get(/databases/$(database)/documents/transparency_files/$(fileId)).data.published == true;
        allow write: if request.auth != null;
      }
    }
  }
}
